<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_closure_event_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.closure.event.list</field>
        <field name="model">helpdesk.ticket.closure.event</field>
        <field name="arch" type="xml">
            <list string="Closure History" create="0" delete="0" edit="0">
                <field name="event_date" />
                <field name="event_type" widget="badge"
                    decoration-success="event_type == 'close'"
                    decoration-warning="event_type == 'reopen'" />
                <field name="occurrence" />
                <field name="from_stage_id" optional="hide" />
                <field name="stage_id" />
                <field name="team_id" optional="show" />
                <field name="user_id" optional="show" />
                <field name="changed_by_id" optional="hide" />
                <field name="hours_from_create" widget="float_time" />
            </list>
        </field>
    </record>

    <record id="helpdesk_closure_event_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.closure.event.search</field>
        <field name="model">helpdesk.ticket.closure.event</field>
        <field name="arch" type="xml">
            <search string="Closure Events">
                <field name="ticket_id" />
                <field name="user_id" />
                <field name="team_id" />
                <filter name="c_close" string="Closures" domain="[('event_type', '=', 'close')]" />
                <filter name="c_reopen" string="Reopens" domain="[('event_type', '=', 'reopen')]" />
                <filter
                    name="c_first"
                    string="First closure only"
                    domain="[('event_type', '=', 'close'), ('occurrence', '=', 1)]"
                />
                <separator />
                <filter name="c_period" string="In period" date="event_date" default_period="month" />
                <group expand="0" string="Group By">
                    <filter name="gc_type" string="Event" context="{'group_by': 'event_type'}" />
                    <filter name="gc_team" string="Team" context="{'group_by': 'team_id'}" />
                    <filter name="gc_user" string="Person" context="{'group_by': 'user_id'}" />
                    <filter name="gc_month" string="Month" context="{'group_by': 'event_date:month'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_helpdesk_closure_events" model="ir.actions.act_window">
        <field name="name">Closure &amp; Reopen Events</field>
        <field name="res_model">helpdesk.ticket.closure.event</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="helpdesk_closure_event_view_search" />
        <field name="context">{'search_default_c_period': 1}</field>
    </record>
</odoo>
