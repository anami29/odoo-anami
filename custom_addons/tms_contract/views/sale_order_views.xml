<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_tms_contract" model="ir.ui.view">
        <field name="name">sale.order.form.tms.contract</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tms_approve_contract_customer" type="object" string="Approve for contract customer"
                        invisible="tms_contract_id or tms_contract_approved_by_id or state not in ('draft', 'sent')"
                        groups="tms_core.group_branch_manager"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_contract" type="object" class="oe_stat_button" icon="fa-handshake-o"
                        invisible="not tms_contract_id" string="Contract"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="tms_contract_id" invisible="not tms_contract_id"/>
                <field name="tms_contract_approved_by_id" invisible="not tms_contract_approved_by_id"/>
            </xpath>
        </field>
    </record>
</odoo>
