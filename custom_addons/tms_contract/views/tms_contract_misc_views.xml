<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- extensions (BR-CON-13, BR-CON-16) -->
    <record id="tms_contract_extension_form" model="ir.ui.view">
        <field name="name">tms.contract.extension.form</field>
        <field name="model">tms.contract.extension</field>
        <field name="arch" type="xml">
            <form string="Contract extension">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'to_approve'"
                            groups="tms_core.group_branch_manager,tms_core.group_operations_head"/>
                    <button name="action_refuse" type="object" string="Refuse" invisible="state != 'to_approve'"
                            groups="tms_core.group_branch_manager,tms_core.group_operations_head"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Customer amendment reference" readonly="state != 'draft'"/></h1></div>
                    <group>
                        <group>
                            <field name="contract_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="file" filename="filename" readonly="state != 'draft'"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="added_value" readonly="state != 'draft'"/>
                            <field name="new_date_end" readonly="state != 'draft'"/>
                            <field name="rates_effective_date" readonly="state != 'draft'"/>
                            <field name="approval_role"/>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="absorbed_excess" invisible="not absorbed_excess"/>
                        </group>
                    </group>
                    <separator string="New rates (Operations Head approves)"/>
                    <field name="rate_ids" readonly="state != 'draft'" context="{'default_contract_id': contract_id, 'default_date_from': rates_effective_date}">
                        <list editable="bottom">
                            <field name="contract_id" column_invisible="1"/>
                            <field name="kind"/>
                            <field name="vehicle_class_id" invisible="kind != 'vehicle'" required="kind == 'vehicle'"/>
                            <field name="product_id" invisible="kind == 'vehicle'" required="kind == 'accessory'"/>
                            <field name="name"/>
                            <field name="basis"/>
                            <field name="rate"/>
                            <field name="date_from"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="tms_contract_extension_list" model="ir.ui.view">
        <field name="name">tms.contract.extension.list</field>
        <field name="model">tms.contract.extension</field>
        <field name="arch" type="xml">
            <list>
                <field name="contract_id"/>
                <field name="name"/>
                <field name="date"/>
                <field name="added_value" sum="Added"/>
                <field name="new_date_end"/>
                <field name="approval_role"/>
                <field name="state" widget="badge" decoration-warning="state == 'to_approve'" decoration-success="state == 'approved'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_tms_contract_extension" model="ir.actions.act_window">
        <field name="name">Extensions</field>
        <field name="res_model">tms.contract.extension</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- excess approvals (BR-CON-18) -->
    <record id="tms_contract_excess_form" model="ir.ui.view">
        <field name="name">tms.contract.excess.form</field>
        <field name="model">tms.contract.excess</field>
        <field name="arch" type="xml">
            <form string="Excess approval">
                <header>
                    <button name="action_request" type="object" string="Request" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'requested'"
                            groups="tms_core.group_contract_excess_approver"/>
                    <button name="action_refuse" type="object" string="Refuse" invisible="state != 'requested'"
                            groups="tms_core.group_contract_excess_approver"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,requested,approved,closed"/>
                </header>
                <div class="alert alert-info" role="alert" invisible="not needs_director or state != 'requested'">
                    Above the excess ceiling: a director approves (OP-20).
                </div>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="contract_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="sale_line_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="move_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="cover" readonly="state != 'draft'"/>
                            <field name="expected_cover_date"/>
                        </group>
                        <group>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_on" invisible="not approved_on"/>
                            <field name="open_amount"/>
                            <field name="absorbed_amount"/>
                            <field name="lapsed_amount"/>
                            <field name="needs_director" invisible="1"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Why the excess is needed" readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="tms_contract_excess_list" model="ir.ui.view">
        <field name="name">tms.contract.excess.list</field>
        <field name="model">tms.contract.excess</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="contract_id"/>
                <field name="sale_line_id"/>
                <field name="move_id"/>
                <field name="amount" sum="Amount"/>
                <field name="cover"/>
                <field name="expected_cover_date"/>
                <field name="open_amount" sum="Open"/>
                <field name="requested_by_id"/>
                <field name="state" widget="badge" decoration-warning="state == 'requested'" decoration-success="state == 'approved'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="tms_contract_excess_search" model="ir.ui.view">
        <field name="name">tms.contract.excess.search</field>
        <field name="model">tms.contract.excess</field>
        <field name="arch" type="xml">
            <search>
                <field name="contract_id"/>
                <filter name="requested" string="To approve" domain="[('state', '=', 'requested')]"/>
                <filter name="open" string="Open" domain="[('state', '=', 'approved')]"/>
            </search>
        </field>
    </record>
    <record id="action_tms_contract_excess" model="ir.actions.act_window">
        <field name="name">Excess approvals</field>
        <field name="res_model">tms.contract.excess</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_requested': 1}</field>
    </record>

    <!-- reservation ledger (BR-CON-20) -->
    <record id="tms_contract_reservation_list" model="ir.ui.view">
        <field name="name">tms.contract.reservation.list</field>
        <field name="model">tms.contract.reservation</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="contract_id"/>
                <field name="item_no"/>
                <field name="event"/>
                <field name="amount" sum="Open reservations"/>
                <field name="consignment_id"/>
                <field name="trip_id"/>
                <field name="source"/>
                <field name="note"/>
                <field name="user_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="tms_contract_reservation_search" model="ir.ui.view">
        <field name="name">tms.contract.reservation.search</field>
        <field name="model">tms.contract.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="contract_id"/>
                <field name="sale_line_id"/>
                <field name="consignment_id"/>
                <field name="trip_id"/>
                <field name="event"/>
                <group expand="0" string="Group by">
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_item" string="Item" context="{'group_by': 'sale_line_id'}"/>
                    <filter name="group_event" string="Event" context="{'group_by': 'event'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="tms_contract_reservation_pivot" model="ir.ui.view">
        <field name="name">tms.contract.reservation.pivot</field>
        <field name="model">tms.contract.reservation</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="contract_id" type="row"/>
                <field name="event" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_tms_contract_reservation" model="ir.actions.act_window">
        <field name="name">Reservation ledger</field>
        <field name="res_model">tms.contract.reservation</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <!-- escalation (BR-CON-22) -->
    <record id="tms_contract_escalation_form" model="ir.ui.view">
        <field name="name">tms.contract.escalation.form</field>
        <field name="model">tms.contract.escalation</field>
        <field name="arch" type="xml">
            <form string="Diesel escalation revision">
                <header>
                    <button name="action_compute" type="object" string="Compute revised rates" invisible="state != 'draft'"/>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary" invisible="state != 'draft'"
                            groups="tms_core.group_operations_head"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="diesel_price" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="base_price"/>
                            <field name="change"/>
                            <field name="change_pct"/>
                            <field name="within_band"/>
                            <field name="applied_by_id" invisible="not applied_by_id"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="old_rate"/>
                            <field name="adjustment"/>
                            <field name="new_rate"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="tms_contract_escalation_list" model="ir.ui.view">
        <field name="name">tms.contract.escalation.list</field>
        <field name="model">tms.contract.escalation</field>
        <field name="arch" type="xml">
            <list>
                <field name="contract_id"/>
                <field name="date"/>
                <field name="diesel_price"/>
                <field name="change"/>
                <field name="within_band"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_tms_contract_escalation" model="ir.actions.act_window">
        <field name="name">Diesel escalation</field>
        <field name="res_model">tms.contract.escalation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
