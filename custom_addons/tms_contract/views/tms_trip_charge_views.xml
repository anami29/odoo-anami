<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tms_trip_charge_form_tms_contract" model="ir.ui.view">
        <field name="name">tms.trip.charge.form.tms.contract</field>
        <field name="model">tms.trip.charge</field>
        <field name="inherit_id" ref="tms_core.tms_trip_charge_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expense_id']" position="after">
                <field name="tms_cost_line_id" options="{'no_create': True}"/>
                <field name="tms_contract_id" invisible="not tms_contract_id"/>
                <field name="tms_contract_incidental" invisible="not tms_contract_id"/>
            </xpath>
        </field>
    </record>
</odoo>
