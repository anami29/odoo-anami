<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="spreadsheet_spreadsheet_form_view_collab" model="ir.ui.view">
        <field name="name">spreadsheet.spreadsheet.form (collab)</field>
        <field name="model">spreadsheet.spreadsheet</field>
        <field name="inherit_id" ref="spreadsheet_oca.spreadsheet_spreadsheet_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_versions"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-history"
                >
                    <field name="collab_version_count" widget="statinfo" string="Versions" />
                </button>
            </xpath>
            <xpath expr="//field[@name='owner_id']" position="attributes">
                <attribute name="help">Only the owner (or a Spreadsheet Manager) can change access or transfer ownership.</attribute>
            </xpath>
            <xpath expr="//field[@name='owner_id']" position="after">
                <field name="collab_source_attachment_id" invisible="not collab_source_attachment_id" />
            </xpath>
        </field>
    </record>
</odoo>
