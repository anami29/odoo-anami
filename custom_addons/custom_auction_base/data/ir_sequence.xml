<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_auction_event_reverse" model="ir.sequence">
            <field name="name">Auction Event (Reverse)</field>
            <field name="code">auction.event.reverse</field>
            <field name="prefix">RA/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_auction_event_forward" model="ir.sequence">
            <field name="name">Auction Event (Forward)</field>
            <field name="code">auction.event.forward</field>
            <field name="prefix">FA/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_auction_bid" model="ir.sequence">
            <field name="name">Auction Bid</field>
            <field name="code">auction.bid</field>
            <field name="prefix">BID/%(year)s/</field>
            <field name="padding">7</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_auction_award" model="ir.sequence">
            <field name="name">Auction Award</field>
            <field name="code">auction.award</field>
            <field name="prefix">AWD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_auction_clarification" model="ir.sequence">
            <field name="name">Auction Clarification</field>
            <field name="code">auction.clarification</field>
            <field name="prefix">CLR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_auction_corrigendum" model="ir.sequence">
            <field name="name">Auction Corrigendum</field>
            <field name="code">auction.corrigendum</field>
            <field name="prefix">COR/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
