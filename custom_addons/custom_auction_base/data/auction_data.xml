<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default sealed rule set. India profile values per AMD-AUC-002:
             bid validity 120 days is the stated norm for works and services. -->
        <record id="rule_set_sealed_default" model="auction.rule.set">
            <field name="name">Sealed — default</field>
            <field name="visibility">none</field>
            <field name="entry_mode">free</field>
            <field name="tie_break">earliest</field>
            <field name="limit_enforcement">reject</field>
            <field name="rank_basis">landed_cost</field>
            <field name="precision_digits">2</field>
            <field name="bid_validity_days">120</field>
            <field name="anti_snipe" eval="False"/>
        </record>

        <!-- Closure: cron plus lazy close-on-access. One minute is the Odoo
             floor and is sufficient for sealed events, which is why v1.0
             does not need the sub-minute scheduler. TSD #9.2. -->
        <record id="cron_close_due_lots" model="ir.cron">
            <field name="name">Auction: close due lots</field>
            <field name="model_id" ref="model_auction_lot"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- The event header closes only once no lot is still taking bids.
             Runs after the lot cron, so a staggered close settles first. -->
        <record id="cron_close_expired_bidding" model="ir.cron">
            <field name="name">Auction: close bidding on expired events</field>
            <field name="model_id" ref="model_auction_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_expired_bidding()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_security_deadline" model="ir.cron">
            <field name="name">Auction: bid security verification deadline</field>
            <field name="model_id" ref="model_auction_bid_security"/>
            <field name="state">code</field>
            <field name="code">model._cron_verification_deadline()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
