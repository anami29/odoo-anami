<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auction_bid_list" model="ir.ui.view">
        <field name="name">auction.bid.list</field>
        <field name="model">auction.bid</field>
        <field name="arch" type="xml">
            <list string="Bid Ledger" create="false" edit="false" delete="false">
                <field name="reference"/>
                <field name="event_id"/>
                <field name="lot_id"/>
                <field name="participant_id"/>
                <field name="chain_seq"/>
                <field name="server_ts"/>
                <field name="source"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_auction_bid_form" model="ir.ui.view">
        <field name="name">auction.bid.form</field>
        <field name="model">auction.bid</field>
        <field name="arch" type="xml">
            <form string="Bid" create="false" edit="false" delete="false">
                <sheet>
                    <div class="alert alert-info" role="status">
                        This is an append-only ledger record. It cannot be
                        edited or deleted by any user, including an
                        administrator. Corrections are recorded as a new bid
                        that supersedes this one.
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="reference"/>
                            <field name="event_id"/>
                            <field name="lot_id"/>
                            <field name="participant_id"/>
                            <field name="round_no"/>
                            <field name="state"/>
                            <field name="supersedes_id"/>
                        </group>
                        <group string="Integrity">
                            <field name="chain_seq"/>
                            <field name="payload_version"/>
                            <field name="prev_hash"/>
                            <field name="record_hash"/>
                            <field name="server_ts"/>
                            <field name="source"/>
                        </group>
                    </group>
                    <field name="offline_justification"
                           invisible="source != 'offline_entry'"/>
                    <field name="line_ids">
                        <list create="false" edit="false" delete="false">
                            <field name="line_id"/>
                            <field name="qty_offered"/>
                            <field name="price_unit"/>
                            <field name="norm_value"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_auction_bid" model="ir.actions.act_window">
        <field name="name">Bid Ledger</field>
        <field name="res_model">auction.bid</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="view_auction_audit_list" model="ir.ui.view">
        <field name="name">auction.audit.list</field>
        <field name="model">auction.audit</field>
        <field name="arch" type="xml">
            <list string="Audit Log" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="action"/>
                <field name="model"/>
                <field name="res_id"/>
                <field name="event_id"/>
                <field name="login"/>
            </list>
        </field>
    </record>

    <record id="action_auction_audit" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">auction.audit</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
