<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         Opened bids. This is the "see the prices" screen.

         Until the envelopes are opened there is nothing here at all, and
         that is correct: a sealed bid line carries a NULL price by design,
         so the price exists nowhere in the database until an opening puts
         it here.
         =================================================================== -->

    <record id="view_auction_evaluation_line_list" model="ir.ui.view">
        <field name="name">auction.evaluation.line.list</field>
        <field name="model">auction.evaluation.line</field>
        <field name="arch" type="xml">
            <list string="Opened Bids" create="false" edit="false"
                  delete="false" default_order="line_id, norm_value">
                <field name="lot_id" optional="show"/>
                <field name="line_id"/>
                <field name="participant_id" string="Bidder"/>
                <field name="rank" string="Rank"
                       decoration-bf="rank == 1"
                       decoration-success="rank == 1"/>
                <field name="price_unit" string="Unit price" digits="[18, 2]"
                       decoration-bf="rank == 1"/>
                <field name="qty_offered" string="Qty offered" digits="[18, 2]"/>
                <field name="line_value" string="Bid value"/>
                <field name="max_deviation_days" string="Slip (days)"
                       optional="show"
                       decoration-warning="max_deviation_days &gt; 0"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="event_id" column_invisible="1"/>
                <button name="action_award_this" type="object"
                        string="Award to this bidder" icon="fa-gavel"
                        class="btn-link"
                        groups="custom_auction_base.group_auction_event_owner"/>
            </list>
        </field>
    </record>

    <record id="view_auction_evaluation_line_form" model="ir.ui.view">
        <field name="name">auction.evaluation.line.form</field>
        <field name="model">auction.evaluation.line</field>
        <field name="arch" type="xml">
            <form string="Opened Bid" create="false" edit="false"
                  delete="false">
                <header>
                    <button name="action_award_this" type="object"
                            string="Award to this bidder" class="oe_highlight"
                            icon="fa-gavel"
                            groups="custom_auction_base.group_auction_event_owner"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        A decrypted value. The sealed envelope on the ledger
                        was never overwritten, so the original record is
                        still verifiable against its hash.
                    </div>
                    <group>
                        <group string="What was bid">
                            <field name="participant_id"/>
                            <field name="price_unit" digits="[18, 2]"/>
                            <field name="qty_offered" digits="[18, 2]"/>
                            <field name="line_value"/>
                            <field name="max_deviation_days"/>
                            <field name="rank"/>
                        </group>
                        <group string="Against what">
                            <field name="event_id"/>
                            <field name="lot_id"/>
                            <field name="line_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Provenance">
                        <field name="bid_id"/>
                        <field name="bid_line_id"/>
                        <field name="opening_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Rows are lines, columns are bidders. Not the landed-cost
         comparative statement of stage 10, but it answers the question an
         operator actually asks: who quoted what, side by side. -->
    <record id="view_auction_evaluation_line_pivot" model="ir.ui.view">
        <field name="name">auction.evaluation.line.pivot</field>
        <field name="model">auction.evaluation.line</field>
        <field name="arch" type="xml">
            <pivot string="Comparative">
                <field name="line_id" type="row"/>
                <field name="participant_id" type="col"/>
                <field name="line_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_auction_evaluation_line_search" model="ir.ui.view">
        <field name="name">auction.evaluation.line.search</field>
        <field name="model">auction.evaluation.line</field>
        <field name="arch" type="xml">
            <search string="Opened Bids">
                <field name="participant_id"/>
                <field name="line_id"/>
                <field name="lot_id"/>
                <field name="event_id"/>
                <filter name="slipped" string="Delivery slips"
                        domain="[('max_deviation_days', '&gt;', 0)]"/>
                <filter name="on_time" string="On schedule"
                        domain="[('max_deviation_days', '&lt;=', 0)]"/>
                <group expand="1" string="Group By">
                    <filter name="group_line" string="Line item"
                            context="{'group_by': 'line_id'}"/>
                    <filter name="group_lot" string="Lot"
                            context="{'group_by': 'lot_id'}"/>
                    <filter name="group_bidder" string="Bidder"
                            context="{'group_by': 'participant_id'}"/>
                    <filter name="group_event" string="Event"
                            context="{'group_by': 'event_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_auction_evaluation_line" model="ir.actions.act_window">
        <field name="name">Opened Bids</field>
        <field name="res_model">auction.evaluation.line</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="context">{'search_default_group_line': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing has been opened yet</p>
            <p>
                Opened bid values appear here after an envelope opening.
                Until then a sealed price exists only inside its envelope,
                which is the point of a sealed bid.
            </p>
        </field>
    </record>

</odoo>
