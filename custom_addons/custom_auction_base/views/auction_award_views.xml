<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_auction_award_list" model="ir.ui.view">
        <field name="name">auction.award.list</field>
        <field name="model">auction.award</field>
        <field name="arch" type="xml">
            <list string="Awards">
                <field name="name"/>
                <field name="event_id"/>
                <field name="direction"/>
                <field name="vendor_count"/>
                <field name="total_value" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'generated'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_auction_award_form" model="ir.ui.view">
        <field name="name">auction.award.form</field>
        <field name="model">auction.award</field>
        <field name="arch" type="xml">
            <form string="Award">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_generate_documents" type="object"
                            string="Generate Documents" class="oe_highlight"
                            invisible="state not in ('approved', 'error')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,generated"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Navigating to the orders needs the licence that
                             reads them; counting them does not. FIX-016. -->
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                groups="purchase.group_purchase_user,sales_team.group_sale_salesman"
                                invisible="document_count == 0">
                            <field name="document_count" widget="statinfo"
                                   string="Documents"/>
                        </button>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'error'">
                        Document generation failed. The award itself is
                        unaffected and this can be retried.
                        <field name="generation_error" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="direction"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="total_value"/>
                            <field name="vendor_count"/>
                            <field name="approved_by" readonly="1"
                                   invisible="state == 'draft'"/>
                            <field name="approved_on" readonly="1"
                                   invisible="state == 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocation">
                            <div class="text-muted mb-2">
                                One row per line item. Pick the winning bidder
                                and the bid line that set the price. Tick
                                'Not the best bid' where you are not awarding
                                to the best offer; a written justification is
                                then required.
                            </div>
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="event_id" column_invisible="1"/>
                                    <field name="lot_id" readonly="evaluation_line_id"/>
                                    <field name="line_id"/>
                                    <!-- Pick the opened bid, not the price.
                                         Everything else on the row comes
                                         from the opening. -->
                                    <field name="evaluation_line_id"
                                           string="Opened bid"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="evaluation_rank" string="Rank"
                                           decoration-success="evaluation_rank == 1"
                                           decoration-warning="evaluation_rank &gt; 1"/>
                                    <field name="participant_id"
                                           readonly="evaluation_line_id"/>
                                    <field name="bid_line_id" optional="hide"
                                           readonly="evaluation_line_id"/>
                                    <field name="qty_awarded" digits="[18, 2]"/>
                                    <field name="price_unit"
                                           readonly="evaluation_line_id"/>
                                    <field name="awarded_value" sum="Total"/>
                                    <field name="is_override"/>
                                    <field name="justification"
                                           optional="show"
                                           required="is_override"/>
                                    <field name="order_id" optional="hide"
                                           readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Recommendation">
                            <field name="recommendation"
                                   placeholder="Internal reasoning. Never shown to a bidder."
                                   readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_auction_award" model="ir.actions.act_window">
        <field name="name">Awards</field>
        <field name="res_model">auction.award</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Every order that came out of a tender, in one list. The linkage
         already exists on each order; without a list of them the only way
         to answer "which of our POs were competitively tendered" is to open
         orders one at a time and look. -->
    <record id="action_auction_purchase_order" model="ir.actions.act_window">
        <field name="name">Purchase Orders Raised from Auctions</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('auction_event_id', '!=', False)]</field>
        <field name="context">{'search_default_group_auction_event': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No orders raised yet</p>
            <p>
                Orders appear here once an approved award has generated its
                documents. Each one carries the event, the award and the lot
                it came from, so an auditor can walk from the order back to
                the sealed bid that set its price.
            </p>
        </field>
    </record>

    <record id="action_auction_sale_order" model="ir.actions.act_window">
        <field name="name">Sale Orders Raised from Auctions</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('auction_event_id', '!=', False)]</field>
        <field name="context">{'search_default_group_auction_event': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No orders raised yet</p>
            <p>
                Disposal sale orders appear here once an approved award has
                generated its documents.
            </p>
        </field>
    </record>

    <!-- ========== linkage back from the transactional documents ========= -->
    <record id="view_purchase_order_form_auction" model="ir.ui.view">
        <field name="name">purchase.order.form.auction</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_auction_event" type="object"
                        class="oe_stat_button" icon="fa-gavel"
                        invisible="not auction_event_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Auction</span>
                    </div>
                </button>
            </div>
            <xpath expr="//field[@name='order_line']/list/field[@name='name']"
                   position="after">
                <field name="auction_hsn_sac" string="HSN/SAC"
                       optional="show" readonly="1"/>
                <field name="auction_delivery_location_id"
                       string="Deliver to" optional="hide" readonly="1"/>
            </xpath>
            <field name="partner_ref" position="after">
                <field name="auction_event_id" readonly="1"
                       invisible="not auction_event_id"/>
                <field name="auction_award_id" readonly="1"
                       invisible="not auction_award_id"/>
                <field name="auction_lot_id" readonly="1"
                       invisible="not auction_lot_id"/>
                <field name="auction_delivery_location_id"
                       readonly="1"
                       invisible="not auction_delivery_location_id"/>
                <field name="auction_delivery_note" readonly="1"
                       invisible="not auction_delivery_note"/>
            </field>
        </field>
    </record>

    <!-- The group-by the two order actions above default to. Declared as an
         inherited filter rather than passed as a raw context group_by, so
         the control panel shows it as a removable facet the operator can
         see and switch off. -->
    <record id="view_purchase_order_filter_auction" model="ir.ui.view">
        <field name="name">purchase.order.search.auction</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <group position="inside">
                <filter name="group_auction_event" string="Auction Event"
                        context="{'group_by': 'auction_event_id'}"/>
            </group>
        </field>
    </record>

    <record id="view_sales_order_filter_auction" model="ir.ui.view">
        <field name="name">sale.order.search.auction</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <group position="inside">
                <filter name="group_auction_event" string="Auction Event"
                        context="{'group_by': 'auction_event_id'}"/>
            </group>
        </field>
    </record>

    <record id="view_sale_order_form_auction" model="ir.ui.view">
        <field name="name">sale.order.form.auction</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_auction_event" type="object"
                        class="oe_stat_button" icon="fa-gavel"
                        invisible="not auction_event_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Auction</span>
                    </div>
                </button>
            </div>
            <xpath expr="//field[@name='order_line']/list/field[@name='name']"
                   position="after">
                <field name="auction_hsn_sac" string="HSN/SAC"
                       optional="show" readonly="1"/>
            </xpath>
            <field name="client_order_ref" position="after">
                <field name="auction_event_id" readonly="1"
                       invisible="not auction_event_id"/>
                <field name="auction_award_id" readonly="1"
                       invisible="not auction_award_id"/>
                <field name="auction_lot_id" readonly="1"
                       invisible="not auction_lot_id"/>
            </field>
        </field>
    </record>

</odoo>
