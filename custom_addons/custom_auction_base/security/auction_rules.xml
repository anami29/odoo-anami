<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Internal: company isolation on every engine model. -->
        <record id="rule_event_company" model="ir.rule">
            <field name="name">Auction event: company</field>
            <field name="model_id" ref="model_auction_event"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Portal bidders see only events they participate in. Global rule:
             no group can widen it, and no context key modifies it. -->
        <record id="rule_event_portal" model="ir.rule">
            <field name="name">Auction event: own participation only</field>
            <field name="model_id" ref="model_auction_event"/>
            <field name="groups" eval="[(4, ref('group_auction_bidder'))]"/>
            <field name="domain_force">[('participant_ids.commercial_partner_id','=',user.partner_id.commercial_partner_id.id)]</field>
        </record>

        <!-- Cross-bidder isolation. BR-SEC-004. The bid line rule is
             INDEPENDENT rather than inherited through bid_id, so a direct
             search_read on the line model is also constrained. -->
        <record id="rule_bid_portal" model="ir.rule">
            <field name="name">Auction bid: own organisation only</field>
            <field name="model_id" ref="model_auction_bid"/>
            <field name="groups" eval="[(4, ref('group_auction_bidder'))]"/>
            <field name="domain_force">[('participant_id.commercial_partner_id','=',user.partner_id.commercial_partner_id.id)]</field>
        </record>

        <record id="rule_bid_line_portal" model="ir.rule">
            <field name="name">Auction bid line: own organisation only</field>
            <field name="model_id" ref="model_auction_bid_line"/>
            <field name="groups" eval="[(4, ref('group_auction_bidder'))]"/>
            <field name="domain_force">[('bid_id.participant_id.commercial_partner_id','=',user.partner_id.commercial_partner_id.id)]</field>
        </record>

        <record id="rule_participant_portal" model="ir.rule">
            <field name="name">Participant: own organisation only</field>
            <field name="model_id" ref="model_auction_participant"/>
            <field name="groups" eval="[(4, ref('group_auction_bidder'))]"/>
            <field name="domain_force">[('commercial_partner_id','=',user.partner_id.commercial_partner_id.id)]</field>
        </record>

        <record id="rule_security_portal" model="ir.rule">
            <field name="name">Bid security: own organisation only</field>
            <field name="model_id" ref="model_auction_bid_security"/>
            <field name="groups" eval="[(4, ref('group_auction_bidder'))]"/>
            <field name="domain_force">[('participant_id.commercial_partner_id','=',user.partner_id.commercial_partner_id.id)]</field>
        </record>

        <record id="rule_bid_line_schedule_portal" model="ir.rule">
            <field name="name">Offered schedule: own organisation only</field>
            <field name="model_id" ref="model_auction_bid_line_schedule"/>
            <field name="groups" eval="[(4, ref('group_auction_bidder'))]"/>
            <field name="domain_force">[('bid_line_id.bid_id.participant_id.commercial_partner_id','=',user.partner_id.commercial_partner_id.id)]</field>
        </record>

        <!-- Defence in depth. A bidder has no ACL on the evaluation working
             set at all, so this rule grants nothing today; it exists so
             that if anyone ever adds a read row for bidders, competitors'
             opened prices are already fenced rather than newly exposed. -->
        <record id="rule_evaluation_portal" model="ir.rule">
            <field name="name">Opened bid: own organisation only</field>
            <field name="model_id" ref="model_auction_evaluation_line"/>
            <field name="groups" eval="[(4, ref('group_auction_bidder'))]"/>
            <field name="domain_force">[('participant_id.commercial_partner_id','=',user.partner_id.commercial_partner_id.id)]</field>
        </record>

        <!-- ==============================================================
             Portal content. These three rules are the disclosure boundary
             for everything a bidder reads, and they are deliberately
             expressed as record rules rather than as template logic: a
             field left out of a QWeb template is not a security control,
             and the next person to edit the template will not know that it
             was one.
             ============================================================== -->

        <!-- A bidder sees buyer documents only once PUBLISHED, plus their
             own uploads, and never another bidder's. -->
        <record id="rule_document_portal" model="ir.rule">
            <field name="name">Auction document: published, or own upload</field>
            <field name="model_id" ref="model_auction_document"/>
            <field name="groups" eval="[(4, ref('group_auction_bidder'))]"/>
            <field name="domain_force">['|','&amp;',('participant_id','=',False),('is_published','=',True),('participant_id.commercial_partner_id','=',user.partner_id.commercial_partner_id.id)]</field>
        </record>

        <!-- A bidder sees their OWN question in any state, and anybody's
             question once the answer is published. The template strips the
             asker; this rule is what stops an unpublished competitor
             question being readable at all. -->
        <record id="rule_clarification_portal" model="ir.rule">
            <field name="name">Clarification: own question, or published answer</field>
            <field name="model_id" ref="model_auction_clarification"/>
            <field name="groups" eval="[(4, ref('group_auction_bidder'))]"/>
            <field name="domain_force">['|',('state','=','published'),('participant_id.commercial_partner_id','=',user.partner_id.commercial_partner_id.id)]</field>
        </record>

        <record id="rule_corrigendum_portal" model="ir.rule">
            <field name="name">Corrigendum: issued only</field>
            <field name="model_id" ref="model_auction_corrigendum"/>
            <field name="groups" eval="[(4, ref('group_auction_bidder'))]"/>
            <field name="domain_force">[('state','=','issued')]</field>
        </record>

        <!-- ==============================================================
             Reporting. The analysis view carries opened prices, so it is
             fenced exactly like the working set it reads from, not more
             loosely because it is "only a report".
             ============================================================== -->
        <record id="rule_analysis_company" model="ir.rule">
            <field name="name">Auction analysis: company</field>
            <field name="model_id" ref="model_auction_analysis"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Defence in depth, as for the evaluation working set: a bidder
             has no ACL row on this model at all, so the rule grants nothing
             today. It exists so that adding one later cannot expose a
             competitor's price by omission. -->
        <record id="rule_analysis_portal" model="ir.rule">
            <field name="name">Auction analysis: own organisation only</field>
            <field name="model_id" ref="model_auction_analysis"/>
            <field name="groups" eval="[(4, ref('group_auction_bidder'))]"/>
            <field name="domain_force">[('participant_id.commercial_partner_id','=',user.partner_id.commercial_partner_id.id)]</field>
        </record>

    </data>
</odoo>
