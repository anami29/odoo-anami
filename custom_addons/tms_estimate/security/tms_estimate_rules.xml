<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_tms_estimate_branch" model="ir.rule">
        <field name="name">tms.estimate: allowed branches</field>
        <field name="model_id" ref="model_tms_estimate"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tms_estimate_line_branch" model="ir.rule">
        <field name="name">tms.estimate.line: allowed branches</field>
        <field name="model_id" ref="model_tms_estimate_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tms_estimate_amendment_branch" model="ir.rule">
        <field name="name">tms.estimate.amendment: allowed branches</field>
        <field name="model_id" ref="model_tms_estimate_amendment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tms_so_pnl_branch" model="ir.rule">
        <field name="name">tms.so.pnl: allowed branches</field>
        <field name="model_id" ref="model_tms_so_pnl"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tms_so_pnl_line_branch" model="ir.rule">
        <field name="name">tms.so.pnl.line: allowed branches</field>
        <field name="model_id" ref="model_tms_so_pnl_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tms_lead_lane_branch" model="ir.rule">
        <field name="name">tms.lead.lane: allowed branches</field>
        <field name="model_id" ref="model_tms_lead_lane"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <!-- BR-CRM-01: a Sales Executive works the whole pipeline of the branch (the branch rule still applies) -->
    <record id="rule_crm_lead_sales_executive_branch" model="ir.rule">
        <field name="name">Pipeline: the branch's opportunities for Sales Executives</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('tms_core.group_sales_executive'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
