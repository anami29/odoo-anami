<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales activities live in the CRM and Sales apps: opportunities and the pipeline stay in CRM;
         quotations, cost estimates and their reports sit in Sales (Transport keeps operations only) -->
    <menuitem id="menu_tms_estimates" name="Cost estimates" parent="sale.sale_order_menu"
              action="action_tms_estimate" sequence="15"/>
    <menuitem id="menu_tms_sale_reports" name="Transport" parent="sale.menu_sale_report" sequence="50"/>
    <menuitem id="menu_tms_report_so_pnl" name="Sales order P&amp;L" parent="menu_tms_sale_reports"
              action="action_tms_so_pnl" sequence="10"/>
    <menuitem id="menu_tms_report_so_pnl_line" name="Estimate against actual" parent="menu_tms_sale_reports"
              action="action_tms_so_pnl_line" sequence="20"/>
    <!-- the sales approvers read the Sales reports too -->
    <record id="sale.menu_sale_report" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('tms_core.group_branch_manager')), (4, ref('tms_core.group_operations_head')), (4, ref('tms_core.group_finance_head'))]"/>
    </record>
    <menuitem id="menu_tms_config_cost_category" name="Cost categories" parent="tms.config" action="action_tms_cost_category" sequence="60"/>
    <menuitem id="menu_tms_config_cost_items" name="Cost items" parent="tms.config" action="action_tms_cost_items" sequence="61"/>
    <!-- BR-DSH-02: bills and expenses awaiting variance approval (BR-ACT-06, BR-NTF-10) -->
    <record id="action_tms_variance_bills" model="ir.actions.act_window">
        <field name="name">Bills awaiting variance approval</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft'), ('tms_variance_approved_by_id', '=', False), ('activity_ids.summary', '=', 'Variance approval needed')]</field>
    </record>
    <record id="action_tms_variance_expenses" model="ir.actions.act_window">
        <field name="name">Expenses awaiting variance approval</field>
        <field name="res_model">tms.trip.expense</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft'), ('variance_approved_by_id', '=', False), ('activity_ids.summary', '=', 'Variance approval needed')]</field>
    </record>
    <menuitem id="menu_tms_variance_bills" name="Bills awaiting variance approval" parent="tms.dashboard" action="action_tms_variance_bills" sequence="20"/>
    <menuitem id="menu_tms_variance_expenses" name="Expenses awaiting variance approval" parent="tms.dashboard" action="action_tms_variance_expenses" sequence="21"/>
</odoo>
