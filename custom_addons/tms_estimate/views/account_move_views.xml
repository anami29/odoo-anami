<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_tms_estimate" model="ir.ui.view">
        <field name="name">account.move.form.tms.estimate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tms_approve_variance" type="object" string="Approve variance" invisible="state != 'draft' or tms_variance_approved_by_id" groups="tms_core.group_branch_manager"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="tms_estimate_line_id" optional="show" options="{'no_create': True}"/>
                <field name="tms_sale_line_id" optional="hide"/>
            </xpath>
            <xpath expr="//page[@name='tms']//field[@name='tms_gst_mode']" position="after">
                <field name="tms_variance_approved_by_id"/>
            </xpath>
        </field>
    </record>
</odoo>
