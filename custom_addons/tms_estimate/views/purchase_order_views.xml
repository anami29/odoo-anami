<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_tms_estimate" model="ir.ui.view">
        <field name="name">purchase.order.form.tms.estimate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="tms_estimate_line_id" optional="show" options="{'no_create': True}" context="{'tms_trip_id': parent.tms_trip_id}"/>
            </xpath>
        </field>
    </record>
</odoo>
