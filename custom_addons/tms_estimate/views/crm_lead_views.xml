<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_form_tms_estimate" model="ir.ui.view">
        <field name="name">crm.lead.form.tms.estimate</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Enquired lanes" name="tms_lanes">
                    <group>
                        <field name="tms_vat"/>
                        <field name="tms_pan"/>
                        <field name="tms_lane_revenue"/>
                    </group>
                    <field name="tms_lane_ids">
                        <list editable="bottom">
                            <field name="origin_id"/>
                            <field name="destination_id"/>
                            <field name="service_type"/>
                            <field name="vehicle_class_id"/>
                            <field name="tms_cargo_type"/>
                            <field name="loads_per_month"/>
                            <field name="tonnage_per_month"/>
                            <field name="target_rate"/>
                            <field name="quoted_amount"/>
                            <field name="monthly_value" sum="Monthly"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
