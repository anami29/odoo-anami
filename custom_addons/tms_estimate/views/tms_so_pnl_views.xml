<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tms_so_pnl_list" model="ir.ui.view">
        <field name="name">tms.so.pnl.list</field>
        <field name="model">tms.so.pnl</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="order_id"/>
                <field name="item_no"/>
                <field name="partner_id"/>
                <field name="company_id" optional="show"/>
                <field name="tms_cargo_type" optional="hide"/>
                <field name="planned_revenue" sum="Total" optional="show"/>
                <field name="revenue" sum="Total"/>
                <field name="estimated_cost" sum="Total"/>
                <field name="committed" sum="Total"/>
                <field name="actual" sum="Total"/>
                <field name="standard_charge" sum="Total"/>
                <field name="contribution" sum="Total"/>
                <field name="margin_pct"/>
                <field name="variance" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="tms_so_pnl_pivot" model="ir.ui.view">
        <field name="name">tms.so.pnl.pivot</field>
        <field name="model">tms.so.pnl</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="partner_id" type="row"/>
                <field name="revenue" type="measure"/>
                <field name="actual" type="measure"/>
                <field name="contribution" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="tms_so_pnl_search" model="ir.ui.view">
        <field name="name">tms.so.pnl.search</field>
        <field name="model">tms.so.pnl</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="partner_id"/>
                <filter name="odc" string="ODC" domain="[('tms_cargo_type', '=', 'odc')]"/>
                <filter name="by_order" string="Order" context="{'group_by': 'order_id'}"/>
                <filter name="by_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="by_branch" string="Branch" context="{'group_by': 'company_id'}"/>
                <filter name="date" string="Order date" date="date_order"/>
            </search>
        </field>
    </record>
    <record id="action_tms_so_pnl" model="ir.actions.act_window">
        <field name="name">Sales order P&amp;L</field>
        <field name="res_model">tms.so.pnl</field>
        <field name="view_mode">list,pivot</field>
    </record>
    <record id="tms_so_pnl_line_list" model="ir.ui.view">
        <field name="name">tms.so.pnl.line.list</field>
        <field name="model">tms.so.pnl.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="order_id"/>
                <field name="item_no"/>
                <field name="line_no"/>
                <field name="product_id"/>
                <field name="estimated_cost" sum="Total"/>
                <field name="committed" sum="Total"/>
                <field name="actual" sum="Total"/>
                <field name="variance" sum="Total"/>
                <field name="variance_pct"/>
                <button name="action_open_documents" type="object" icon="fa-file-text-o" title="Documents"/>
            </list>
        </field>
    </record>
    <record id="action_tms_so_pnl_line" model="ir.actions.act_window">
        <field name="name">Estimate against actual</field>
        <field name="res_model">tms.so.pnl.line</field>
        <field name="view_mode">list,pivot</field>
    </record>
</odoo>
