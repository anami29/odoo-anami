<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BR-PRN-10, BR-NUM-04: numbered items naming the order item they serve -->
    <template id="report_purchaseorder_document_tms" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="(//span[@t-field='line.name'])[1]" position="before">
            <strong t-if="line.tms_item_no" t-out="'%s/%s ' % (o.name, line.tms_item_no)"/>
        </xpath>
        <xpath expr="(//span[@t-field='line.name'])[1]" position="after">
            <div t-if="line.tms_estimate_line_id" class="small text-muted">For <span t-out="line.tms_estimate_line_id.display_name"/></div>
        </xpath>
    </template>
</odoo>
