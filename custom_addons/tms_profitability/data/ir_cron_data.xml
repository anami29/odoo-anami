<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- BR-PNL-10, BR-PNL-11: monthly release of prepaid fixed costs and spread repairs -->
    <record id="ir_cron_release_prepaid" model="ir.cron">
        <field name="name">TMS: release prepaid truck costs</field>
        <field name="model_id" ref="model_tms_prepaid_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_release_prepaid()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="nextcall" eval="(DateTime.today().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-%d 01:30:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
