        <field name="name">tms.branch.pnl.list</field>
        <field name="model">tms.branch.pnl</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-danger="branch_result &lt; 0">
                <field name="company_id"/>
                <field name="period"/>
                <field name="trip_margin" sum="Total"/>
                <field name="recovery_variance" sum="Total"/>
                <field name="overhead" sum="Total"/>
                <field name="branch_result" sum="Total"/>
                <field name="truck_view" sum="Total"/>
                <field name="check_difference" sum="Total"/>
                <button name="action_open_lines" type="object" icon="fa-search-plus" title="Drill to source"/>
            </list>
        </field>
    </record>
    <record id="tms_branch_pnl_pivot" model="ir.ui.view">
        <field name="name">tms.branch.pnl.pivot</field>
        <field name="model">tms.branch.pnl</field>
        <field name="arch" type="xml">
            <pivot string="Branch P&amp;L" sample="1">
                <field name="company_id" type="row"/>
                <field name="branch_result" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="tms_branch_pnl_search" model="ir.ui.view">
        <field name="name">tms.branch.pnl.search</field>
        <field name="model">tms.branch.pnl</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <filter name="filter_period" string="Period" date="period"/>
                <group expand="0" string="Group by">
                    <filter name="group_company" string="Branch" context="{'group_by': 'company_id'}"/>
                    <filter name="group_period" string="Period" context="{'group_by': 'period:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_tms_branch_pnl" model="ir.actions.act_window">
        <field name="name">Branch P&amp;L</field>
        <field name="res_model">tms.branch.pnl</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{}</field>
    </record>
    <record id="action_tms_trip_pnl_wip" model="ir.actions.act_window">
        <field name="name">Work in progress</field>
        <field name="res_model">tms.trip.pnl</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('wip', '=', True)]</field>
    </record>
    <record id="tms_company_pnl_list" model="ir.ui.view">
        <field name="name">tms.company.pnl.list</field>
        <field name="model">tms.branch.pnl</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="company_id"/>
                <field name="period"/>
                <field name="branch_result" sum="Total"/>
                <field name="head_office_cost" sum="Total"/>
                <field name="operating_result" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="action_tms_company_pnl" model="ir.actions.act_window">
        <field name="name">Company P&amp;L</field>
        <field name="res_model">tms.branch.pnl</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="tms_company_pnl_list"/>
    </record>
</odoo>
