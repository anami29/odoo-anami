<?xml version="1.0" encoding="utf-8"?>
<!-- #18.4, BR-PNL-24..34: P&L views; every view filters by branch, period, customer,
     vehicle class, fleet type and Cargo Type, drills to its lines and exports to Excel from the list -->
<odoo>
    <record id="tms_pnl_line_list" model="ir.ui.view">
        <field name="name">tms.pnl.line.list</field>
        <field name="model">tms.pnl.line</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-danger="amount &lt; 0">
                <field name="date"/>
                <field name="period" optional="hide"/>
                <field name="kind"/>
                <field name="company_id"/>
                <field name="trip_id"/>
                <field name="consignment_id" optional="show"/>
                <field name="partner_id"/>
                <field name="vendor_id" optional="hide"/>
                <field name="vehicle_id"/>
                <field name="cost_pool" optional="hide"/>
                <field name="is_replacement" optional="hide"/>
                <field name="account_id" optional="hide"/>
                <field name="move_line_id" optional="show"/>
                <field name="analytic_line_id" optional="hide"/>
                <field name="line_kind" optional="hide"/>
                <field name="amount" sum="Total"/>
                <button name="action_open_source" type="object" icon="fa-external-link" title="Open source document"/>
            </list>
        </field>
    </record>
    <record id="tms_pnl_line_pivot" model="ir.ui.view">
        <field name="name">tms.pnl.line.pivot</field>
        <field name="model">tms.pnl.line</field>
        <field name="arch" type="xml">
            <pivot string="Ledger lines" sample="1">
                <field name="kind" type="row"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="tms_pnl_line_search" model="ir.ui.view">
        <field name="name">tms.pnl.line.search</field>
        <field name="model">tms.pnl.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="trip_id"/>
                <field name="vendor_id"/>
                <filter name="wip" string="Work in progress" domain="[('wip', '=', True)]"/>
                <filter name="not_wip" string="In period results" domain="[('wip', '=', False)]"/>
                <filter name="filter_period" string="Period" date="period"/>
                <group expand="0" string="Group by">
                    <filter name="group_company" string="Branch" context="{'group_by': 'company_id'}"/>
                    <filter name="group_period" string="Period" context="{'group_by': 'period:month'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_vehicle" string="Truck" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="group_pool" string="Pool" context="{'group_by': 'cost_pool'}"/>
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_trip" string="Trip" context="{'group_by': 'trip_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_tms_pnl_line" model="ir.actions.act_window">
        <field name="name">Ledger lines</field>
        <field name="res_model">tms.pnl.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{}</field>
    </record>
