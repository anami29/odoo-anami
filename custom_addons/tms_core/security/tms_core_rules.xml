    <!-- LR: booking or delivery branch; any Confirmed LR may be read for cross-branch planning (BR-BRN-10) -->
    <record id="rule_tms_consignment_read" model="ir.rule">
        <field name="name">tms.consignment: read</field>
        <field name="model_id" ref="model_tms_consignment"/>
        <field name="global" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', '|', '|', ('company_id', '=', False), ('company_id', 'in', company_ids), ('delivery_branch_id', 'in', company_ids), ('state', '=', 'confirmed')]</field>
    </record>
    <record id="rule_tms_consignment_write" model="ir.rule">
        <field name="name">tms.consignment: write</field>
        <field name="model_id" ref="model_tms_consignment"/>
        <field name="global" eval="True"/>
        <field name="perm_read" eval="False"/>
        <field name="domain_force">['|', '|', ('company_id', '=', False), ('company_id', 'in', company_ids), ('delivery_branch_id', 'in', company_ids)]</field>
    </record>
    <!-- OCA's empty global trip rule becomes a branch rule -->
    <record id="tms.tms_order_comp_rule" model="ir.rule">
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
