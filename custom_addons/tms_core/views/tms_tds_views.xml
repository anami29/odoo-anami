<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BR-HIR-14: hire paid without TDS under a transporter declaration, for the quarterly TDS statement -->
    <record id="view_tms_tds_declaration_extract_list" model="ir.ui.view">
        <field name="name">tms.tds.declaration.extract.list</field>
        <field name="model">account.move.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="move_id" string="Bill"/>
                <field name="partner_id" string="Vendor"/>
                <field name="tms_vendor_pan"/>
                <field name="tms_tds_declaration_ref"/>
                <field name="tms_trip_id"/>
                <field name="name"/>
                <field name="company_id" string="Branch" groups="base.group_multi_company"/>
                <field name="balance" string="Hire paid" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_tms_tds_declaration_extract_search" model="ir.ui.view">
        <field name="name">tms.tds.declaration.extract.search</field>
        <field name="model">account.move.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" string="Vendor"/>
                <field name="tms_vendor_pan"/>
                <filter name="date" string="Date" date="date"/>
                <group expand="1">
                    <filter name="group_quarter" string="Quarter" context="{'group_by': 'date:quarter'}"/>
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tms_tds_declaration_extract" model="ir.actions.act_window">
        <field name="name">Hire paid under TDS declaration</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="view_tms_tds_declaration_extract_list"/>
        <field name="search_view_id" ref="view_tms_tds_declaration_extract_search"/>
        <field name="domain">[('tms_line_kind', '=', 'hire'), ('move_id.tms_tds_declaration_exempt', '=', True), ('parent_state', '=', 'posted')]</field>
        <field name="context">{'search_default_group_quarter': 1}</field>
    </record>

    <menuitem id="menu_tms_report_tds" name="TDS on hire (declarations)" parent="tms.reporting"
              action="action_tms_tds_declaration_extract" sequence="10"/>
</odoo>
