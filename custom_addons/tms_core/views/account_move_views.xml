<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_tms_core" model="ir.ui.view">
        <field name="name">account.move.form.tms.core</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tms_record_customer_tds" type="object" string="Record customer TDS" invisible="move_type != 'out_invoice' or state != 'posted' or tms_tds_move_id"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="tms_consignment_id" optional="show"/>
                <field name="tms_trip_id" optional="show"/>
                <field name="tms_line_kind" optional="hide"/>
                <field name="tms_cost_class" optional="show"/>
                <field name="tms_overhead" optional="hide"/>
                <field name="tms_overhead_reason" optional="hide"/>
                <field name="tms_charge_id" optional="hide"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Transport" name="tms" invisible="move_type == 'entry'">
                    <group>
                        <group>
                            <field name="tms_gst_mode"/>
                            <field name="tms_rcm_legend" invisible="not tms_rcm_legend"/>
                            <field name="tms_credit_reason" invisible="move_type not in ('out_refund', 'in_refund')"/>
                            <field name="tms_claim_id" invisible="not tms_claim_id"/>
                            <field name="tms_is_accrual" invisible="not tms_is_accrual"/>
                        </group>
                        <group invisible="move_type != 'out_invoice'">
                            <field name="tms_submission_date"/>
                            <field name="tms_pod_copies_sent"/>
                            <field name="tms_acknowledgement"/>
                            <field name="tms_customer_tds_amount"/>
                            <field name="tms_tds_move_id"/>
                        </group>
                        <group invisible="move_type != 'in_invoice'">
                            <field name="tms_tds_declaration_exempt"/>
                            <field name="tms_tds_declaration_ref"/>
                            <field name="tms_match_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="tms_consignment_ids" widget="many2many_tags"/>
                </page>
            </xpath>
        </field>
    </record>
    <record id="action_tms_receivables_ageing" model="ir.actions.act_window">
        <field name="name">Receivables ageing</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('account_id.account_type', '=', 'asset_receivable'), ('reconciled', '=', False), ('parent_state', '=', 'posted')]</field>
        <field name="context">{'pivot_row_groupby': ['partner_id'], 'pivot_column_groupby': ['company_id'], 'pivot_measures': ['amount_residual']}</field>
    </record>
</odoo>
