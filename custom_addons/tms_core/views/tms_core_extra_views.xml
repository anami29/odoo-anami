<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BR-EWB-03: per-state intra-state e-way bill thresholds -->
    <record id="view_tms_ewaybill_state_threshold_list" model="ir.ui.view">
        <field name="name">tms.ewaybill.state.threshold.list</field>
        <field name="model">tms.ewaybill.state.threshold</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="state_id"/>
                <field name="threshold"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_tms_ewaybill_state_threshold" model="ir.actions.act_window">
        <field name="name">Intra-state e-way bill thresholds</field>
        <field name="res_model">tms.ewaybill.state.threshold</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_tms_ewaybill_state_threshold" name="E-way bill state thresholds" parent="tms.config"
              action="action_tms_ewaybill_state_threshold" sequence="70"/>

    <!-- BR-CFG-10: the Finance Head keeps the GTA GST option per financial year -->
    <record id="view_tms_gta_option_list" model="ir.ui.view">
        <field name="name">tms.gta.option.list</field>
        <field name="model">tms.gta.option</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="option"/>
            </list>
        </field>
    </record>
    <record id="action_tms_gta_option" model="ir.actions.act_window">
        <field name="name">GTA GST options</field>
        <field name="res_model">tms.gta.option</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_tms_gta_option" name="GTA GST options" parent="tms.config"
              action="action_tms_gta_option" sequence="72"
              groups="tms_core.group_finance_head,tms_core.group_tms_admin"/>

    <!-- BR-DSH-01: filter the exception dashboard by branch, customer, vehicle and period -->
    <record id="view_tms_kpi_filter_form" model="ir.ui.view">
        <field name="name">tms.kpi.filter.form</field>
        <field name="model">tms.kpi.filter</field>
        <field name="arch" type="xml">
            <form string="Filter the dashboard">
                <group>
                    <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                    <field name="partner_id"/>
                    <field name="vehicle_id"/>
                    <field name="date_from"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Show" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_tms_kpi_filter" model="ir.actions.act_window">
        <field name="name">Filter the dashboard</field>
        <field name="res_model">tms.kpi.filter</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_tms_kpi_filter" name="Filtered dashboard" parent="tms.dashboard" action="action_tms_kpi_filter" sequence="2"/>

    <!-- BR-DSH-05: vehicle utilisation -->
    <record id="view_tms_vehicle_utilisation_list" model="ir.ui.view">
        <field name="name">tms.vehicle.utilisation.list</field>
        <field name="model">tms.vehicle.utilisation</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="month"/>
                <field name="vehicle_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="trip_count" sum="Total"/>
                <field name="hours_on_trip" sum="Total"/>
                <field name="km_run" sum="Total"/>
                <field name="utilisation" avg="Average"/>
            </list>
        </field>
    </record>
    <record id="view_tms_vehicle_utilisation_pivot" model="ir.ui.view">
        <field name="name">tms.vehicle.utilisation.pivot</field>
        <field name="model">tms.vehicle.utilisation</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="vehicle_id" type="row"/>
                <field name="month" interval="month" type="col"/>
                <field name="utilisation" type="measure"/>
                <field name="km_run" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_tms_vehicle_utilisation_search" model="ir.ui.view">
        <field name="name">tms.vehicle.utilisation.search</field>
        <field name="model">tms.vehicle.utilisation</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="company_id"/>
                <filter name="month" string="Month" date="month"/>
                <group>
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'month:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_tms_vehicle_utilisation" model="ir.actions.act_window">
        <field name="name">Vehicle utilisation</field>
        <field name="res_model">tms.vehicle.utilisation</field>
        <field name="view_mode">pivot,list</field>
    </record>
    <menuitem id="menu_tms_vehicle_utilisation" name="Vehicle utilisation" parent="tms_core.menu_tms_rep_fleet"
              action="action_tms_vehicle_utilisation" sequence="20" groups="tms_core.group_owned_fleet_menus"/>

    <!-- BR-BRN-06: collect a To-Pay invoice at the delivery branch -->
    <record id="view_tms_topay_collect_wizard_form" model="ir.ui.view">
        <field name="name">tms.topay.collect.wizard.form</field>
        <field name="model">tms.topay.collect.wizard</field>
        <field name="arch" type="xml">
            <form string="Collect at delivery branch">
                <group>
                    <field name="move_id"/>
                    <field name="delivery_branch_id"/>
                    <field name="journal_id"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="date"/>
                </group>
                <footer>
                    <button name="action_collect" type="object" string="Collect" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_move_form_tms_topay_collect" model="ir.ui.view">
        <field name="name">account.move.form.tms.topay.collect</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tms_collect_at_delivery" type="object" string="Collect at delivery branch"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state in ('paid', 'in_payment') or tms_gst_mode == False"
                        groups="tms_core.group_booking_clerk,tms_core.group_branch_accountant"/>
            </xpath>
        </field>
    </record>
</odoo>
