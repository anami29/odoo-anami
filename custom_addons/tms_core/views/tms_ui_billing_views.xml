<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vendor bill: the three-way match of hire memo, verified POD and bill, on the bill itself -->
    <record id="account_move_form_tms_ui_billing" model="ir.ui.view">
        <field name="name">account.move.form.tms.ui.billing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tms_rerun_match" type="object" string="Re-run match"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'in_invoice' or state != 'draft' or not (tms_match_state or tms_ui_hire_memo_count)"/>
                <button name="action_tms_apply_recoveries" type="object" string="Apply recoveries"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'in_invoice' or state != 'draft' or not tms_match_state"/>
                <button name="action_tms_add_unbilled_charges" type="object" string="Add Approved Trip Charges"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'out_invoice' or state != 'draft' or not tms_unbilled_charge_count"/>
                <field name="tms_match_state" widget="badge" nolabel="1"
                       decoration-danger="tms_match_state == 'hold'" decoration-success="tms_match_state == 'passed'"
                       invisible="move_type != 'in_invoice' or not tms_match_state"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_tms_view_lrs" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        invisible="move_type not in ('out_invoice', 'out_refund') or not tms_inv_lr_count">
                    <field name="tms_inv_lr_count" string="Consignment" widget="statinfo"/>
                </button>
                <button name="action_tms_view_unbilled_charges" type="object" class="oe_stat_button" icon="fa-plus-square-o"
                        invisible="move_type != 'out_invoice' or not tms_unbilled_charge_count">
                    <div class="o_stat_info">
                        <span class="o_stat_value text-warning"><field name="tms_unbilled_charge_count" readonly="1"/> unbilled</span>
                        <span class="o_stat_text">Trip charges</span>
                    </div>
                </button>
                <button name="action_tms_view_claims" type="object" class="oe_stat_button" icon="fa-clipboard"
                        invisible="move_type not in ('in_invoice', 'in_refund') or not tms_ui_claim_count">
                    <field name="tms_ui_claim_count" string="Recovery" widget="statinfo"/>
                </button>
                <button name="action_tms_view_trips" type="object" class="oe_stat_button" icon="fa-truck"
                        invisible="not tms_ui_trip_count">
                    <field name="tms_ui_trip_count" string="Trip" widget="statinfo"/>
                </button>
                <button name="action_tms_view_hire_memos" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        invisible="move_type not in ('in_invoice', 'in_refund') or not tms_ui_hire_memo_count">
                    <field name="tms_ui_hire_memo_count" string="Hire memo" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="tms_hire_memo_refs" readonly="1"
                       invisible="move_type not in ('in_invoice', 'in_refund') or not tms_hire_memo_refs"/>
                <field name="tms_tds_note" readonly="1" invisible="not tms_tds_note"/>
                <field name="tms_billing_basis" readonly="1" invisible="not tms_billing_basis"/>
                <field name="tms_rate_line" readonly="1" invisible="not tms_rate_line"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="journal_id" string="Journal" readonly="1" options="{'no_open': True}"
                       invisible="move_type not in ('out_invoice', 'out_refund') or not tms_billing_basis"/>
                <field name="fiscal_position_id" readonly="1" options="{'no_open': True}"
                       invisible="move_type not in ('in_invoice', 'in_refund') or not tms_hire_memo_refs"/>
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="after">
                <div class="alert alert-warning" role="alert" invisible="move_type != 'out_invoice' or not tms_unbilled_note or state == 'cancel'">
                    <field name="tms_unbilled_note" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//group[hasclass('oe_invoice_lines_tab')]" position="after">
                <div class="text-muted small text-end" invisible="not tms_rcm_note"><field name="tms_rcm_note" nolabel="1"/></div>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="purchase_line_id" string="Source" optional="show" readonly="1"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
            <xpath expr="//page[@id='other_tab']" position="before">
                <page string="Three-way match" name="tms_three_way_match"
                      invisible="move_type != 'in_invoice' or not tms_match_state">
                    <div class="text-muted mb-2">
                        <span>Hire memo · verified POD · vendor bill. </span>
                        <field name="tms_match_tolerance_note" class="d-inline" readonly="1"/>
                    </div>
                    <field name="tms_pod_element" nolabel="1"/>
                    <field name="tms_match_line_ids" readonly="1" nolabel="1">
                        <list create="0" edit="0" delete="0" decoration-danger="result == 'fail'">
                            <field name="kind"/>
                            <field name="label"/>
                            <field name="approved" sum="Total"/>
                            <field name="billed" sum="Total"/>
                            <field name="variance" sum="Total"/>
                            <field name="tolerance"/>
                            <field name="result" column_invisible="1"/>
                            <field name="result_label" widget="badge"
                                   decoration-success="result == 'pass'" decoration-danger="result == 'fail'"/>
                            <button name="action_use_approved" type="object" string="Use approved" icon="fa-check"
                                    invisible="result != 'fail' or kind not in ('hire', 'extra') or parent.state != 'draft'"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer" name="tms_match_totals">
                        <field name="tms_match_approved"/>
                        <field name="tms_match_recoveries"/>
                        <field name="tms_match_net_payable" class="oe_subtotal_footer_separator"/>
                        <field name="tms_match_bill_amount"/>
                        <field name="tms_match_variance"
                               decoration-danger="tms_match_variance != 0"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Transport › Trip money › Invoices: customer invoices and credit notes that bill an LR -->
    <record id="action_tms_freight_invoices" model="ir.actions.act_window">
        <field name="name">Freight invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('account.view_out_invoice_tree')}),
            Command.create({'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('invoice_line_ids.tms_consignment_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No freight invoice yet</p>
            <p>Freight invoices are raised from delivered LRs; each one lists the LRs it bills.</p>
        </field>
    </record>
    <menuitem id="menu_tms_money_invoices" name="Invoices" parent="tms_core.menu_tms_finance" sequence="5"/>
    <menuitem id="menu_tms_freight_invoices" name="Freight invoices" parent="menu_tms_money_invoices"
              action="action_tms_freight_invoices" sequence="10"
              groups="account.group_account_invoice,account.group_account_readonly"/>
</odoo>
