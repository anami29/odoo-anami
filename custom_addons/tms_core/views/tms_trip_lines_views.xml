<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- POD lines -->
    <record id="tms_trip_consignment_form" model="ir.ui.view">
        <field name="name">tms.trip.consignment.form</field>
        <field name="model">tms.trip.consignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_delivered" type="object" string="Delivered" class="btn-primary" invisible="outcome or state == 'cancel'"/>
                    <button name="action_mark_not_delivered" type="object" string="Not delivered" invisible="outcome or state == 'cancel'"/>
                    <button name="action_mark_refused" type="object" string="Refused" invisible="outcome or state == 'cancel'"/>
                    <button name="action_upload_pod" type="object" string="Upload POD" invisible="not outcome or pod_status not in ('pending', 'rejected')"/>
                    <button name="action_verify_pod" type="object" string="Verify POD" class="btn-primary" invisible="pod_status != 'uploaded'" groups="tms_core.group_pod_verifier"/>
                    <button name="action_open_reason" type="object" string="Reject POD" invisible="pod_status != 'uploaded'" groups="tms_core.group_pod_verifier" context="{'tms_reason_method': 'action_reject_pod'}"/>
                    <button name="action_open_reason" type="object" string="Remove from trip" invisible="state == 'cancel' or outcome" context="{'tms_reason_method': 'action_remove_from_trip', 'tms_show_waive': True}"/>
                    <button name="action_print_pod_form" type="object" string="Print POD form"/>
                    <field name="pod_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Link">
                            <field name="trip_id" readonly="1"/>
                            <field name="consignment_id" readonly="1"/>
                            <field name="assignment_id" readonly="1"/>
                            <field name="packages" readonly="1"/>
                            <field name="weight" readonly="1"/>
                            <field name="drop_sequence"/>
                            <field name="state" readonly="1"/>
                            <field name="removal_reason" invisible="state != 'cancel'"/>
                        </group>
                        <group string="Delivery">
                            <field name="outcome" readonly="1"/>
                            <field name="delivered_at"/>
                            <field name="received_by"/>
                            <field name="packages_received"/>
                            <field name="shortage_qty"/>
                            <field name="damage_qty"/>
                            <field name="outcome_evidence" filename="outcome_evidence_name"/>
                            <field name="outcome_evidence_name" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="POD">
                            <field name="pod_file" filename="pod_file_name"/>
                            <field name="pod_file_name" invisible="1"/>
                            <field name="uploaded_by_id"/>
                            <field name="uploaded_on"/>
                            <field name="verified_by_id"/>
                            <field name="verified_on"/>
                            <field name="reject_reason" invisible="pod_status != 'rejected'"/>
                        </group>
                        <group string="Follow-up">
                            <field name="incident_id"/>
                            <field name="claim_id"/>
                            <field name="remarks"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="tms_trip_consignment_list" model="ir.ui.view">
        <field name="name">tms.trip.consignment.list</field>
        <field name="model">tms.trip.consignment</field>
        <field name="arch" type="xml">
            <list decoration-danger="pod_overdue" create="0">
                <field name="trip_id"/>
                <field name="consignment_id"/>
                <field name="delivery_branch_id" optional="show"/>
                <field name="delivered_at"/>
                <field name="outcome"/>
                <field name="uploaded_by_id" optional="show"/>
                <field name="pod_status"/>
                <field name="pod_overdue" column_invisible="1"/>
                <button name="action_verify_pod" type="object" string="Verify" invisible="pod_status != 'uploaded'" groups="tms_core.group_pod_verifier"/>
            </list>
        </field>
    </record>
    <record id="tms_trip_consignment_search" model="ir.ui.view">
        <field name="name">tms.trip.consignment.search</field>
        <field name="model">tms.trip.consignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="consignment_id"/>
                <field name="trip_id"/>
                <filter name="to_verify" string="To verify" domain="[('pod_status', '=', 'uploaded')]"/>
                <filter name="overdue" string="Past SLA" domain="[('pod_overdue', '=', True)]"/>
                <filter name="active_links" string="Active" domain="[('state', '=', 'active')]"/>
            </search>
        </field>
    </record>
    <record id="action_tms_pod" model="ir.actions.act_window">
        <field name="name">POD verification</field>
        <field name="res_model">tms.trip.consignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_verify': 1, 'search_default_active_links': 1}</field>
    </record>

    <!-- Assignments -->
    <record id="tms_trip_assignment_list" model="ir.ui.view">
        <field name="name">tms.trip.assignment.list</field>
        <field name="model">tms.trip.assignment</field>
        <field name="arch" type="xml">
            <list create="0" decoration-success="state == 'open'">
                <field name="trip_id" optional="show"/>
                <field name="sequence"/>
                <field name="reason"/>
                <field name="fleet_type"/>
                <field name="vehicle_number"/>
                <field name="driver_id"/>
                <field name="market_driver_name" optional="show"/>
                <field name="hire_memo_id" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="odometer_out"/>
                <field name="odometer_in"/>
                <field name="gate_result"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="tms_trip_assignment_form" model="ir.ui.view">
        <field name="name">tms.trip.assignment.form</field>
        <field name="model">tms.trip.assignment</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="trip_id" readonly="1"/>
                            <field name="sequence" readonly="1"/>
                            <field name="reason" readonly="1"/>
                            <field name="fleet_type" readonly="1"/>
                            <field name="vehicle_id" readonly="1"/>
                            <field name="market_vehicle_id" readonly="1"/>
                            <field name="vehicle_number" readonly="1"/>
                            <field name="driver_id" readonly="1"/>
                            <field name="market_driver_name"/>
                            <field name="market_driver_phone"/>
                            <field name="market_driver_licence"/>
                            <field name="market_driver_licence_expiry"/>
                        </group>
                        <group>
                            <field name="broker_id"/>
                            <field name="hire_memo_id"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to"/>
                            <field name="odometer_out"/>
                            <field name="odometer_in"/>
                            <field name="km_run"/>
                            <field name="state" readonly="1"/>
                            <field name="gate_result"/>
                        </group>
                    </group>
                    <separator string="Gate snapshot (BR-CMP-09)"/>
                    <field name="gate_snapshot"/>
                    <field name="gate_messages"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- DSR -->
    <record id="tms_trip_dsr_list" model="ir.ui.view">
        <field name="name">tms.trip.dsr.list</field>
        <field name="model">tms.trip.dsr</field>
        <field name="arch" type="xml">
            <list editable="top" decoration-danger="status in ('delayed_breakdown', 'delayed_traffic', 'delayed_other')">
                <field name="trip_id" optional="show"/>
                <field name="logged_at"/>
                <field name="location"/>
                <field name="status"/>
                <field name="consignment_id" optional="show"/>
                <field name="eta"/>
                <field name="remark"/>
                <field name="source"/>
                <field name="logged_by_id" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="action_tms_dsr_log" model="ir.actions.act_window">
        <field name="name">DSR log</field>
        <field name="res_model">tms.trip.dsr</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Breakdowns -->
    <record id="tms_trip_breakdown_form" model="ir.ui.view">
        <field name="name">tms.trip.breakdown.form</field>
        <field name="model">tms.trip.breakdown</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state != 'open' or not id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="trip_id" readonly="id"/>
                            <field name="assignment_id"/>
                            <field name="vehicle_id"/>
                            <field name="reported_at"/>
                            <field name="location"/>
                            <field name="cause"/>
                            <field name="odometer"/>
                        </group>
                        <group>
                            <field name="resolution" readonly="1"/>
                            <field name="resumed_at"/>
                            <field name="downtime_hours"/>
                            <field name="repair_cost"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cost_responsibility"/>
                            <field name="service_log_id"/>
                            <field name="incident_id"/>
                            <field name="replacement_assignment_id"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What happened"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="tms_trip_breakdown_list" model="ir.ui.view">
        <field name="name">tms.trip.breakdown.list</field>
        <field name="model">tms.trip.breakdown</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'open'">
                <field name="trip_id"/>
                <field name="vehicle_id"/>
                <field name="reported_at"/>
                <field name="location"/>
                <field name="cause"/>
                <field name="resolution"/>
                <field name="downtime_hours"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_tms_breakdown" model="ir.actions.act_window">
        <field name="name">Breakdowns</field>
        <field name="res_model">tms.trip.breakdown</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Incidents -->
    <record id="tms_trip_incident_form" model="ir.ui.view">
        <field name="name">tms.trip.incident.form</field>
        <field name="model">tms.trip.incident</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_create_expense" type="object" string="Add expense" invisible="state != 'open' or not moves_money"/>
                    <button name="action_create_charge" type="object" string="Add charge" invisible="state != 'open' or not moves_money"/>
                    <button name="action_create_claim" type="object" string="Claim" invisible="state != 'open' or not moves_money"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="trip_id"/>
                            <field name="consignment_id"/>
                            <field name="category_id"/>
                            <field name="occurred_at"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="responsible"/>
                            <field name="responsible_partner_id"/>
                            <field name="estimated_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="moves_money"/>
                            <field name="reported_by_id"/>
                            <field name="claim_id"/>
                            <field name="breakdown_id"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description"/>
                    <notebook>
                        <page string="Expenses"><field name="expense_ids" readonly="1"/></page>
                        <page string="Charges"><field name="charge_ids" readonly="1"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="tms_trip_incident_list" model="ir.ui.view">
        <field name="name">tms.trip.incident.list</field>
        <field name="model">tms.trip.incident</field>
        <field name="arch" type="xml">
            <list>
                <field name="trip_id"/>
                <field name="consignment_id"/>
                <field name="category_id"/>
                <field name="occurred_at"/>
                <field name="responsible"/>
                <field name="estimated_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_tms_incident" model="ir.actions.act_window">
        <field name="name">Incidents</field>
        <field name="res_model">tms.trip.incident</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
