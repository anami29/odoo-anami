<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BR-CFG-02: owned-fleet menus show only while a branch runs Hybrid mode -->
    <record id="group_owned_fleet_menus" model="res.groups">
        <field name="name">Owned-fleet menus (Hybrid mode)</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    <record id="group_tms_staff" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_owned_fleet_menus'))]"/>
    </record>
    <record id="tms.menu_fleet_vehicle" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_owned_fleet_menus')])]"/>
    </record>
    <record id="tms.menu_tms_insurance" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_owned_fleet_menus')])]"/>
    </record>
    <record id="tms.menu_fleet_odometers" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_owned_fleet_menus')])]"/>
    </record>
    <record id="tms.menu_tms_driver" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_owned_fleet_menus')])]"/>
    </record>
    <record id="tms.menu_fleet_reporting_cost" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_owned_fleet_menus')])]"/>
    </record>

    <menuitem id="menu_tms_exception_dashboard" name="Exception dashboard" parent="tms.dashboard" action="action_tms_kpi_dashboard" sequence="1"/>

    <!-- Operations, grouped by activity: Booking, Trips, Exceptions, (ODC from tms_odc), Fleet.
         A group heading shows as a caption in the menu and hides itself when none of its items is visible. -->
    <menuitem id="menu_tms_ops_booking" name="Booking" parent="tms.operations" sequence="10"/>
    <menuitem id="menu_tms_lr" name="Consignment notes (LR)" parent="menu_tms_ops_booking" action="action_tms_consignment" sequence="10"/>
    <menuitem id="menu_tms_ewaybill" name="E-way bills" parent="menu_tms_ops_booking" action="action_tms_ewaybill" sequence="30"/>
    <menuitem id="menu_tms_ewaybill_tasks" name="E-way bill tasks" parent="menu_tms_ops_booking" action="action_tms_ewaybill_update" sequence="31"/>

    <menuitem id="menu_tms_ops_trips" name="Trips" parent="tms.operations" sequence="20"/>
    <record id="tms.menu_tms_operation_trip" model="ir.ui.menu">
        <field name="parent_id" ref="menu_tms_ops_trips"/>
        <field name="sequence">10</field>
    </record>
    <menuitem id="menu_tms_planning_board" name="Planning board" parent="menu_tms_ops_trips" action="action_tms_planning_board" sequence="20" groups="group_owned_fleet_menus"/>
    <menuitem id="menu_tms_dsr" name="DSR log" parent="menu_tms_ops_trips" action="action_tms_dsr_log" sequence="30"/>
    <menuitem id="menu_tms_pod" name="POD verification" parent="menu_tms_ops_trips" action="action_tms_pod" sequence="40"/>

    <menuitem id="menu_tms_ops_exceptions" name="Exceptions" parent="tms.operations" sequence="30"/>
    <menuitem id="menu_tms_incident" name="Incidents" parent="menu_tms_ops_exceptions" action="action_tms_incident" sequence="10"/>
    <menuitem id="menu_tms_breakdown" name="Breakdowns" parent="menu_tms_ops_exceptions" action="action_tms_breakdown" sequence="20"/>
    <menuitem id="menu_tms_claim" name="Damage and shortage claims" parent="menu_tms_ops_exceptions" action="action_tms_claim" sequence="30"/>

    <menuitem id="menu_tms_ops_fleet" name="Fleet" parent="tms.operations" sequence="50"/>
    <record id="tms.menu_fleet_odometers" model="ir.ui.menu">
        <field name="parent_id" ref="menu_tms_ops_fleet"/>
        <field name="sequence">10</field>
    </record>

    <!-- Trip money, grouped: Charges, Driver, Hire, (Period close from tms_profitability) -->
    <menuitem id="menu_tms_finance" name="Trip money" parent="tms.root" sequence="25"/>
    <menuitem id="menu_tms_money_charges" name="Charges" parent="menu_tms_finance" sequence="10"/>
    <menuitem id="menu_tms_charge" name="Charges and recoveries" parent="menu_tms_money_charges" action="action_tms_charge" sequence="10"/>
    <menuitem id="menu_tms_expense" name="Trip expenses" parent="menu_tms_money_charges" action="action_tms_expense" sequence="20"/>
    <menuitem id="menu_tms_money_driver" name="Driver" parent="menu_tms_finance" sequence="20"/>
    <menuitem id="menu_tms_driver_advance" name="Driver advances" parent="menu_tms_money_driver" action="action_tms_driver_advance" sequence="10"/>
    <menuitem id="menu_tms_driver_settlement" name="Driver settlements" parent="menu_tms_money_driver" action="action_tms_driver_settlement" sequence="20"/>
    <menuitem id="menu_tms_money_hire" name="Hire" parent="menu_tms_finance" sequence="30"/>
    <menuitem id="menu_tms_hire_memo" name="Hire memos" parent="menu_tms_money_hire" action="action_tms_hire_memo" sequence="10"/>
    <menuitem id="menu_tms_match" name="Three-way matches" parent="menu_tms_money_hire" action="action_tms_vendor_bill_match" sequence="20"/>

    <menuitem id="menu_tms_market_vehicle" name="Market vehicles" parent="tms.data" action="action_tms_market_vehicle" sequence="15"/>
    <menuitem id="menu_tms_compliance_document" name="Compliance documents" parent="tms.data" action="action_tms_compliance_document" sequence="16"/>

    <!-- Reporting, grouped: Registers, Ageing and payables, Fleet, (Profitability from tms_profitability) -->
    <menuitem id="menu_tms_rep_registers" name="Registers" parent="tms.reporting" sequence="10"/>
    <menuitem id="menu_tms_report_lr" name="LR register" parent="menu_tms_rep_registers" action="action_tms_lr_register" sequence="10"/>
    <menuitem id="menu_tms_report_dsr" name="DSR log" parent="menu_tms_rep_registers" action="action_tms_dsr_log" sequence="20"/>
    <menuitem id="menu_tms_report_claims" name="Claims register" parent="menu_tms_rep_registers" action="action_tms_claim" sequence="30"/>
    <menuitem id="menu_tms_report_compliance" name="Compliance expiry" parent="menu_tms_rep_registers" action="action_tms_compliance_document" sequence="40"/>
    <menuitem id="menu_tms_report_override" name="Override log" parent="menu_tms_rep_registers" action="action_tms_override_log" sequence="50"/>

    <menuitem id="menu_tms_rep_ageing" name="Ageing and payables" parent="tms.reporting" sequence="20"/>
    <menuitem id="menu_tms_report_recovery" name="Recovery ageing" parent="menu_tms_rep_ageing" action="action_tms_recovery_ageing" sequence="10"/>
    <menuitem id="menu_tms_report_receivables" name="Receivables ageing" parent="menu_tms_rep_ageing" action="action_tms_receivables_ageing" sequence="20"/>
    <menuitem id="menu_tms_report_hire_payables" name="Hire payables" parent="menu_tms_rep_ageing" action="action_tms_hire_payables" sequence="30"/>

    <menuitem id="menu_tms_rep_fleet" name="Fleet" parent="tms.reporting" sequence="30"/>
    <record id="tms.menu_tms_report_trip" model="ir.ui.menu">
        <field name="parent_id" ref="menu_tms_rep_fleet"/>
        <field name="sequence">10</field>
    </record>
    <record id="tms.menu_fleet_reporting_cost" model="ir.ui.menu">
        <field name="parent_id" ref="menu_tms_rep_fleet"/>
        <field name="sequence">30</field>
    </record>

    <menuitem id="menu_tms_config_category" name="Incident, charge and expense types" parent="tms.config" action="action_tms_category" sequence="50"/>
    <menuitem id="menu_tms_config_doc_type" name="Compliance document types" parent="tms.config" action="action_tms_compliance_document_type" sequence="51"/>
    <menuitem id="menu_tms_config_vehicle_class" name="Vehicle classes" parent="tms.config" action="action_tms_vehicle_class" sequence="52"/>
</odoo>
