<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tms_core" model="ir.ui.view">
        <field name="name">res.config.settings.form.tms.core</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="tms.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- BR-CFG-11: base toggles for modules absent from 18.0 are hidden -->
            <xpath expr="//field[@name='module_tms_account']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='module_tms_sale']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='module_tms_purchase']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='module_tms_expense']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='module_tms_account_asset']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//block[@name='general_settings_container']" position="before">
                <block title="Operating mode and controls" name="tms_core_mode">
                    <setting string="Operating mode" help="Locks once confirmed LRs or trips exist; LRs and trips keep the mode they were created in.">
                        <field name="tms_operation_mode" widget="radio" readonly="tms_mode_locked"/>
                        <div class="text-muted small" invisible="tms_operation_mode != 'hybrid'">Hybrid: owned fleet and hired market fleet. Default.</div>
                        <div class="text-muted small" invisible="tms_operation_mode != 'broker'">Broker / 3PL: market fleet only; the company arranges, bills and settles.</div>
                        <div class="alert alert-warning mt-2 mb-0 py-2" role="status" invisible="not tms_mode_locked">
                            Locked: confirmed LRs and trips exist. Only the TMS Administrator unlocks it, with a reason that is logged.
                            <button name="action_tms_unlock_mode" type="object" string="Unlock…" class="btn btn-link p-0 ms-1" groups="tms_core.group_tms_admin"/>
                        </div>
                        <div class="text-muted small mt-1" invisible="not tms_last_unlock">Last unlocked by <field name="tms_last_unlock" class="d-inline"/></div>
                    </setting>
                    <setting string="What the mode changes" help="Save to apply; the Transport menus follow the saved mode.">
                        <table class="table table-sm small mb-0" invisible="tms_operation_mode != 'hybrid'">
                            <tr><td class="fw-bold">Trip form</td><td>Fleet type: Owned or Market hire</td></tr>
                            <tr><td class="fw-bold">Menus</td><td>Vehicles, Drivers, Insurance, Odometers and Fleet costs shown</td></tr>
                            <tr><td class="fw-bold">Compliance</td><td>Owned fleet from the register; market vehicles on each assignment</td></tr>
                            <tr><td class="fw-bold">Billing</td><td>Freight invoices; vendor bills with the three-way match</td></tr>
                            <tr><td class="fw-bold">Validation</td><td>Hire memo required only on Market hire trips</td></tr>
                        </table>
                        <table class="table table-sm small mb-0" invisible="tms_operation_mode != 'broker'">
                            <tr><td class="fw-bold">Trip form</td><td>Fleet type fixed to Market hire</td></tr>
                            <tr><td class="fw-bold">Menus</td><td>Owned-fleet menus hidden (Vehicles, Drivers, Insurance, Odometers, Fleet costs)</td></tr>
                            <tr><td class="fw-bold">Compliance</td><td>Market vehicle documents on each assignment</td></tr>
                            <tr><td class="fw-bold">Billing</td><td>Freight invoices; every trip has a hire memo and a matched vendor bill</td></tr>
                            <tr><td class="fw-bold">Validation</td><td>Hire memo required on every trip</td></tr>
                        </table>
                    </setting>
                    <setting string="Enforce compliance gate" help="Block the start when a required document is missing or expires before the scheduled end. Only the TMS Administrator changes it; each change is logged.">
                        <field name="tms_enforce_compliance"/>
                        <div class="text-muted small mt-1">Required at start: <field name="tms_required_docs" class="d-inline"/></div>
                        <div class="text-danger small" invisible="tms_enforce_compliance">Off: an expired PUC or fitness certificate does not stop a trip.</div>
                        <div class="mt-2">
                            <field name="tms_enforce_reason" placeholder="Reason, required when you switch enforcement"/>
                        </div>
                    </setting>
                    <setting string="Uploader may verify own POD" help="off by default: a second POD Verifier verifies. Only the TMS Administrator switches it; each switch and each self-verification is logged.">
                        <field name="tms_pod_self_verify"/>
                        <div class="mt-2">
                            <field name="tms_pod_self_verify_reason" placeholder="Reason, required when you switch it"/>
                        </div>
                    </setting>
                    <setting string="Strict branch accounting" help="post in the document branch's journals.">
                        <field name="tms_strict_branch_accounting"/>
                    </setting>
                    <setting string="Require verified POD for vendor bills" help="Vendor bills linked to a hire memo cannot post until the trip's POD is verified. There is no switch and no override.">
                        <span class="badge rounded-pill text-bg-light border">always on</span>
                    </setting>
                    <setting string="Consignment note sequence" help="One LR series per branch; a branch may allow manual numbers from printed LR books, unique per branch and year.">
                        <div class="d-flex gap-2 align-items-baseline"><span>Branch code</span><field name="tms_branch_code" class="w-auto"/></div>
                        <div class="text-muted small" invisible="not tms_lr_next">Next: <field name="tms_lr_next" class="d-inline"/></div>
                        <div><field name="tms_allow_manual_lr"/><label for="tms_allow_manual_lr" string="Allow manual LR numbers"/></div>
                    </setting>
                    <setting string="Hire variance tolerance" help="the lower of the amount and the percent applies.">
                        <div class="d-flex gap-2"><field name="tms_hire_tolerance_amount"/><span>or</span><field name="tms_hire_tolerance_percent"/><span>%</span></div>
                    </setting>
                    <setting string="DSR cadence and POD SLA (hours)">
                        <div class="d-flex gap-2"><field name="tms_dsr_cadence_hours"/><span>/</span><field name="tms_pod_sla_hours"/></div>
                    </setting>
                    <setting string="Document reminder offsets (days)">
                        <field name="tms_reminder_offsets"/>
                    </setting>
                    <setting string="E-way bill threshold">
                        <field name="tms_ewaybill_threshold"/>
                    </setting>
                    <setting string="Charge self-approval limit">
                        <field name="tms_charge_self_approval_limit"/>
                    </setting>
                    <setting string="Maximum hire advance %" help="never above 80%.">
                        <field name="tms_max_advance_percent"/>
                    </setting>
                    <setting string="Godown demurrage per day">
                        <field name="tms_godown_demurrage_per_day"/>
                    </setting>
                </block>
                <block title="Credit and claims" name="tms_core_credit">
                    <setting string="Overdue limit (days)">
                        <field name="tms_overdue_limit_days"/>
                    </setting>
                    <setting string="Claim notice period (days)">
                        <field name="tms_claim_notice_days"/>
                    </setting>
                    <setting string="Carrier liability limit">
                        <field name="tms_carrier_liability_limit"/>
                    </setting>
                    <setting string="Branch Manager claim limit">
                        <field name="tms_claim_bm_limit"/>
                    </setting>
                </block>
                <block title="Trip accounting" name="tms_core_accounts">
                    <setting string="Driver advance account"><field name="tms_driver_advance_account_id"/></setting>
                    <setting string="Trip expense journal"><field name="tms_expense_journal_id"/></setting>
                    <setting string="Cash and bank journals"><div class="d-flex gap-2"><field name="tms_cash_journal_id"/><field name="tms_bank_journal_id"/></div></setting>
                    <setting string="Fuel card and FASTag accounts"><div class="d-flex gap-2"><field name="tms_fuel_card_account_id"/><field name="tms_fastag_account_id"/></div></setting>
                    <setting string="Inter-branch clearing account"><field name="tms_interbranch_account_id"/></setting>
                    <setting string="Freight product"><field name="tms_freight_product_id"/></setting>
                    <setting string="Customer TDS receivable"><field name="tms_tds_receivable_account_id"/></setting>
                    <setting string="TDS on hire and commission" help="a vendor may carry its own hire TDS tax"><div class="d-flex gap-2"><field name="tms_hire_tds_tax_id"/><field name="tms_commission_tds_tax_id"/></div></setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
