<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- BR-EXE-11, BR-NTF-03, BR-PRN-06: daily 09:00 IST (03:30 UTC) DSR email per billing party -->
    <record id="mail_template_daily_dsr" model="mail.template">
        <field name="name">TMS: daily DSR</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">Consignments in transit – {{ datetime.date.today().strftime('%d %b %Y') }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html" type="html">
<div>
    <p>Dear <t t-out="object.name"/>,</p>
    <p>The status of your consignments in transit:</p>
    <table border="1" cellpadding="4" style="border-collapse:collapse">
        <tr><th>LR</th><th>From</th><th>To</th><th>Vehicle</th><th>Last status</th><th>Location</th><th>ETA</th></tr>
        <t t-foreach="ctx.get('tms_links') or []" t-as="link">
            <t t-set="dsr" t-value="link.trip_id.dsr_ids[:1]"/>
            <tr>
                <td t-out="link.consignment_id.name"/>
                <td t-out="link.consignment_id.origin_id.city or link.consignment_id.origin_id.name"/>
                <td t-out="link.consignment_id.destination_id.city or link.consignment_id.destination_id.name"/>
                <td t-out="link.consignment_id.vehicle_number"/>
                <td t-out="dsr and dict(dsr._fields['status'].selection).get(dsr.status) or ''"/>
                <td t-out="dsr.location or ''"/>
                <td t-out="dsr.eta or ''"/>
            </tr>
        </t>
    </table>
</div>
        </field>
    </record>
</odoo>
