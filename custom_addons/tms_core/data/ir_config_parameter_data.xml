<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- BR-NFR-05: two-factor sign-in for internal users (auth_totp_mail_enforce) -->
    <record id="param_auth_totp_policy" model="ir.config_parameter">
        <field name="key">auth_totp.policy</field>
        <field name="value">employee_required</field>
    </record>
    <!-- Compliance gate warning windows. The base module reads these as integers and treats 0 as "never warn".
         Seeded once on install; an upgrade keeps the value set in Settings. -->
    <record id="icp_driver_security_days" model="ir.config_parameter" forcecreate="True">
        <field name="key">tms.default_driver_license_security_days</field>
        <field name="value">15</field>
    </record>
    <record id="icp_vehicle_security_days" model="ir.config_parameter" forcecreate="True">
        <field name="key">tms.default_vehicle_insurance_security_days</field>
        <field name="value">15</field>
    </record>
</odoo>
