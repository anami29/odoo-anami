<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- BR-PRN-08: Marathi is not in Odoo's language list; it is kept here, inactive, as a second print language -->
    <record id="lang_mr_IN" model="res.lang">
        <field name="name">Marathi / मराठी</field>
        <field name="code">mr_IN</field>
        <field name="iso_code">mr</field>
        <field name="url_code">mr</field>
        <field name="direction">ltr</field>
        <field name="date_format">%d/%m/%Y</field>
        <field name="time_format">%H:%M:%S</field>
        <field name="grouping">[3,2,-1]</field>
        <field name="decimal_point">.</field>
        <field name="thousands_sep">,</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
