<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_compliance_reminders" model="ir.cron">
        <field name="name">TMS: compliance document reminders</field>
        <field name="model_id" ref="model_tms_compliance_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_expiry_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_dsr_overdue" model="ir.cron">
        <field name="name">TMS: DSR overdue</field>
        <field name="model_id" ref="model_tms_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_dsr_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_daily_dsr_email" model="ir.cron">
        <field name="name">TMS: daily DSR email to customers</field>
        <field name="model_id" ref="model_tms_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_daily_dsr_email()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="cron_pod_sla" model="ir.cron">
        <field name="name">TMS: POD past SLA</field>
        <field name="model_id" ref="model_tms_trip_consignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_pod_sla()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_ewaybill_expiry" model="ir.cron">
        <field name="name">TMS: e-way bill expiry alert</field>
        <field name="model_id" ref="model_tms_ewaybill"/>
        <field name="state">code</field>
        <field name="code">model._cron_expiry_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_godown_demurrage" model="ir.cron">
        <field name="name">TMS: godown demurrage</field>
        <field name="model_id" ref="model_tms_consignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_godown_demurrage()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_match_escalation" model="ir.cron">
        <field name="name">TMS: escalate blocked hire bills</field>
        <field name="model_id" ref="model_tms_vendor_bill_match"/>
        <field name="state">code</field>
        <field name="code">model._cron_escalate_blocked()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <!-- BR-NFR-13 -->
    <record id="cron_anonymise_drivers" model="ir.cron">
        <field name="name">TMS: anonymise former drivers</field>
        <field name="model_id" ref="tms.model_tms_driver"/>
        <field name="state">code</field>
        <field name="code">model._cron_anonymise_drivers()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
    </record>
</odoo>
