<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="tms_core.TmsScopeBar">
        <div class="o_tms_search" role="search">
            <i class="fa fa-search text-muted small me-1" aria-hidden="true"/>
            <span class="o_tms_facet">
                <span class="k">Branch</span>
                <span class="v">
                    <select class="o_tms_facet_select" t-on-change="onBranch" aria-label="Branch">
                        <t t-foreach="props.scope.branches" t-as="b" t-key="b.id">
                            <option t-att-value="b.id" t-att-selected="b.id === props.scope.company_id" t-esc="b.name"/>
                        </t>
                    </select>
                </span>
            </span>
            <span class="o_tms_facet">
                <span class="k">Period</span>
                <span class="v d-inline-flex align-items-center gap-1">
                    <button type="button" class="o_tms_facet_step" t-on-click="() => this.shift(-1)" aria-label="Previous month">‹</button>
                    <input type="month" class="o_tms_facet_month" t-att-value="month" t-on-change="onMonth" aria-label="Period"/>
                    <button type="button" class="o_tms_facet_step" t-on-click="() => this.shift(1)" aria-label="Next month">›</button>
                </span>
            </span>
            <t t-foreach="props.extra or []" t-as="f" t-key="f_index">
                <span class="o_tms_facet"><span class="k" t-esc="f.k"/><span class="v" t-esc="f.v"/></span>
            </t>
        </div>
    </t>

    <!-- stroke icons used by the tiles -->
    <t t-name="tms_core.TmsIcon">
        <svg class="o_tms_i" viewBox="0 0 24 24" aria-hidden="true">
            <t t-if="icon === 'wrench'"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></t>
            <t t-elif="icon === 'swap'"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></t>
            <t t-elif="icon === 'clipboard'"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/></t>
            <t t-elif="icon === 'undo'"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></t>
            <t t-elif="icon === 'file-check'"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 15 11 17 15 13"/></t>
            <t t-elif="icon === 'clock'"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></t>
            <t t-else=""><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></t>
        </svg>
    </t>

</templates>
