<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Near edge-to-edge margins (8mm); bottom leaves room for the page-number footer. -->
    <record id="paperformat_agreement" model="report.paperformat">
        <field name="name">Agreement Document A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Same page, deeper foot: used automatically when the version prints a signature
         strip on every page, which needs more room than the page number alone. -->
    <record id="paperformat_agreement_sign_footer" model="report.paperformat">
        <field name="name">Agreement Document A4 (signature footer)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">40</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_agreement" model="ir.actions.report">
        <field name="name">Agreement Document</field>
        <field name="model">agreement.agreement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="paperformat_agreement"/>
        <field name="report_name">agreement_management.report_agreement_document</field>
        <field name="report_file">agreement_management.report_agreement_document</field>
        <field name="print_report_name">('%s - %s' % ((object.number or 'Agreement').replace('/', '-'), 'Executed' if object.state == 'executed' else 'Preview'))</field>
        <field name="binding_model_id" ref="model_agreement_agreement"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_agreement_annexure" model="ir.actions.report">
        <field name="name">Supplementary Annexure Document</field>
        <field name="model">agreement.annexure</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="paperformat_agreement"/>
        <field name="report_name">agreement_management.report_agreement_annexure_document</field>
        <field name="report_file">agreement_management.report_agreement_annexure_document</field>
        <field name="print_report_name">('%s - %s' % ((object.number or 'Annexure').replace('/', '-'), 'Executed' if object.state == 'executed' else 'Preview'))</field>
        <field name="binding_model_id" ref="model_agreement_annexure"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_agreement_version" model="ir.actions.report">
        <field name="name">Template Layout Preview</field>
        <field name="model">agreement.template.version</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="paperformat_agreement"/>
        <field name="report_name">agreement_management.report_agreement_version_sample</field>
        <field name="report_file">agreement_management.report_agreement_version_sample</field>
        <field name="print_report_name">('Template %s v%s - Preview' % (object.template_id.code, object.name))</field>
        <field name="binding_model_id" ref="model_agreement_template_version"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
