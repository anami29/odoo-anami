<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agreement_font_list" model="ir.ui.view">
        <field name="name">agreement.font.list</field>
        <field name="model">agreement.font</field>
        <field name="arch" type="xml">
            <list string="Fonts" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="font_family"/>
                <field name="font_file_filename" invisible="1"/>
                <field name="font_file" widget="binary" filename="font_file_filename" string="Font File"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_agreement_font_form" model="ir.ui.view">
        <field name="name">agreement.font.form</field>
        <field name="model">agreement.font</field>
        <field name="arch" type="xml">
            <form string="Font">
                <sheet>
                    <div class="alert alert-info" role="status">
                        Fonts listed here appear in the font dropdown of the agreement content editor — nowhere else
                        in Odoo. A font already installed on the server needs no file; upload a
                        <b>.ttf</b> or <b>.otf</b> to embed a font of your own in the generated PDF.
                    </div>
                    <group>
                        <group string="Font">
                            <field name="name" placeholder="e.g. Aptos"/>
                            <field name="font_family" placeholder="e.g. 'Aptos', sans-serif"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Font File (optional)">
                            <field name="font_file_filename" invisible="1"/>
                            <field name="font_file" widget="binary" filename="font_file_filename"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agreement_font" model="ir.actions.act_window">
        <field name="name">Fonts</field>
        <field name="res_model">agreement.font</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a font</p>
            <p>Fonts added here are offered in the agreement content editor and embedded in the generated PDF.</p>
        </field>
    </record>
</odoo>
