<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tms_document_type_list" model="ir.ui.view">
        <field name="name">tms.document.type.list</field>
        <field name="model">tms.document.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="applies_to"/>
                <field name="behaviour" widget="badge" decoration-info="behaviour == 'transport'" decoration-muted="behaviour == 'standard'"/>
                <field name="is_default"/>
                <field name="invoice_type_id" optional="show"/>
                <field name="sequence_id" optional="show"/>
                <field name="approval_limit" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_tms_document_type_form" model="ir.ui.view">
        <field name="name">tms.document.type.form</field>
        <field name="model">tms.document.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. IT purchase"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="applies_to"/>
                            <field name="behaviour"/>
                            <field name="is_default"/>
                            <field name="invoice_type_id" invisible="applies_to not in ('sale', 'purchase')"/>
                            <field name="vehicle_disposal" invisible="applies_to != 'sale'"/>
                            <field name="is_amc" invisible="applies_to != 'purchase'"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="sequence_id" invisible="applies_to not in ('sale', 'purchase')"/>
                            <field name="journal_id" invisible="applies_to not in ('out_invoice', 'in_invoice')"/>
                            <field name="product_category_ids" widget="many2many_tags"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="approval_limit" invisible="applies_to not in ('sale', 'purchase')"/>
                            <field name="approver_group_ids" widget="many2many_tags" invisible="applies_to not in ('sale', 'purchase')"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="note" placeholder="What this type is for"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_tms_document_type_search" model="ir.ui.view">
        <field name="name">tms.document.type.search</field>
        <field name="model">tms.document.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="transport" string="Transport" domain="[('behaviour', '=', 'transport')]"/>
                <filter name="standard" string="Standard" domain="[('behaviour', '=', 'standard')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_applies" string="Applies to" context="{'group_by': 'applies_to'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_tms_document_type" model="ir.actions.act_window">
        <field name="name">Document types</field>
        <field name="res_model">tms.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_applies': 1}</field>
    </record>
    <menuitem id="menu_tms_config_document_type" name="Document types" parent="tms.config"
              action="action_tms_document_type" sequence="49" groups="tms_core.group_tms_admin,tms_core.group_branch_accountant,tms_core.group_finance_head"/>
</odoo>
