<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_tms_document_type" model="ir.ui.view">
        <field name="name">purchase.order.form.tms.document.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="after">
                <div class="alert alert-info" role="status" invisible="tms_document_behaviour != 'standard'">
                    Standard purchase: no hire memo, trip or estimate line. Bills of this order carry the branch analytic account only.
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="tms_document_type_id" required="1" readonly="state not in ('draft', 'sent')" options="{'no_create': True}"/>
                <field name="tms_document_behaviour" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='tms_estimate_line_id']" position="attributes">
                <attribute name="column_invisible">parent.tms_document_behaviour == 'standard'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
